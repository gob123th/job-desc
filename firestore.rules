rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────── Admin access ─────────────────────────
    // Any account that exists in Firebase Auth and can sign in is treated as an
    // admin (full read/list/write). Manage admins by adding/removing users in the
    // Firebase Console → Authentication. No email-verification or hardcoded
    // allowlist is required here.
    //
    // ⚠️ SECURITY: this means whoever can create a Firebase Auth account is an
    // admin. You MUST disable client-side self sign-up, otherwise anyone with the
    // (public) Firebase config could register themselves and gain admin access:
    //   Firebase Console → Authentication → Settings → User actions →
    //   uncheck "Enable create (sign-up)".
    function isAdmin() {
      return request.auth != null;
    }

    // ───────────────────────── Job descriptions ─────────────────────────
    match /job_descriptions/{docId} {

      // The public requestor form may create a submission, but the document
      // shape is validated: status must be one of the two allowed start states,
      // only the known fields are allowed, and an access code must be present.
      //   APPLICANT_SUBMITTED — normal flow, goes straight to the approver.
      //   PENDING_EMPLOYEE    — employee-acknowledgement flow: one document per
      //                         recipient, each waiting for that employee to sign
      //                         before it is forwarded to the approver.
      allow create: if request.resource.data.status in ['APPLICANT_SUBMITTED', 'PENDING_EMPLOYEE']
                    && request.resource.data.keys().hasOnly([
                         'positionName', 'department', 'location', 'level',
                         'education', 'experience', 'responsibilities',
                         'signatures', 'employeeName', 'startDate',
                         'status', 'createdAt', 'accessCode',
                         'flow', 'recipientEmail', 'approverEmail'
                       ])
                    && request.resource.data.accessCode is string
                    && request.resource.data.accessCode.size() <= 64;

      // Capability-URL model: anyone holding the (unguessable, 20-char) doc ID
      // — i.e. the email link — can read that ONE document. Querying/listing the
      // whole collection is admin-only, which kills the bulk PII/signature dump.
      allow get:  if true;
      allow list: if isAdmin();

      // Approver (step 2) and HR (step 3) update via their email link. With no
      // backend we cannot verify the per-doc access code inside rules, but we DO
      // hard-enforce that: status only becomes APPROVED/COMPLETED, the access
      // hash is immutable, and the original requestor data can't be tampered.
      allow update: if (request.resource.data.status in ['APPROVED', 'COMPLETED']
                        && request.resource.data.accessCode == resource.data.accessCode
                        && request.resource.data.positionName == resource.data.positionName
                        && request.resource.data.department == resource.data.department
                        && request.resource.data.createdAt == resource.data.createdAt)
                     // Employee acknowledgement (sign.html): the recipient of a
                     // PENDING_EMPLOYEE document may add their own signature and
                     // move it into the normal approver queue (APPLICANT_SUBMITTED).
                     // Every JD content field is locked immutable, so the employee
                     // can only touch their own signature / name / start date.
                     || (resource.data.status == 'PENDING_EMPLOYEE'
                        && request.resource.data.status == 'APPLICANT_SUBMITTED'
                        && request.resource.data.accessCode == resource.data.accessCode
                        && request.resource.data.positionName == resource.data.positionName
                        && request.resource.data.department == resource.data.department
                        && request.resource.data.location == resource.data.location
                        && request.resource.data.level == resource.data.level
                        && request.resource.data.responsibilities == resource.data.responsibilities
                        && request.resource.data.education == resource.data.education
                        && request.resource.data.experience == resource.data.experience
                        && request.resource.data.approverEmail == resource.data.approverEmail
                        && request.resource.data.createdAt == resource.data.createdAt)
                     || isAdmin();

      // Never allow client deletes; only an authenticated admin may remove docs.
      allow delete: if isAdmin();
    }

    // ───────────────────── Master lists (config) ─────────────────────
    // Both master lists live in app_config/master as arrays, so the form loads its
    // dropdowns with a single read. index.html reads it (public); only admins write.
    match /app_config/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // LEGACY one-doc-per-item collections. Still readable as the migration source /
    // fallback for clients that run before app_config/master exists.
    match /departments/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }
    match /positions/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ───────────────────────── Mail queue ─────────────────────────
    // Emails that could not be sent immediately because the Gmail account hit its
    // daily cap. The website appends to this queue; an hourly Apps Script trigger
    // drains it. That trigger authenticates with a service account, which bypasses
    // these rules entirely — so nothing here needs to grant a browser read access,
    // and the queue (which stores per-document access codes) stays admin-only.
    match /mail_queue/{docId} {
      // Anyone who can submit the public form may enqueue, because the person
      // filling in a JD is not signed in. The shape is pinned down so the
      // collection cannot be used as free storage.
      allow create: if request.resource.data.status == 'PENDING'
                    && request.resource.data.attempts == 0
                    && request.resource.data.keys().hasOnly([
                         'to', 'subject', 'requesterName', 'reviewUrl', 'accessCode',
                         'kind', 'priority', 'jdId',
                         'status', 'attempts', 'lastError', 'lastCode',
                         'createdAt', 'updatedAt', 'sentAt'
                       ])
                    && request.resource.data.to is string
                    && request.resource.data.to.size() <= 200
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() <= 300
                    && request.resource.data.kind in ['employee_ack', 'approval', 'hr']
                    && request.resource.data.priority is int
                    && request.resource.data.priority >= 1
                    && request.resource.data.priority <= 9;

      // Reading the queue exposes recipient addresses and access codes together,
      // so it is admin-only. Retrying / clearing entries from admin.html is an
      // update, and the Apps Script drainer does not go through these rules.
      allow get, list, update, delete: if isAdmin();
    }

    // ───────────────────────── System log ─────────────────────────
    // Error / event log written by js/logger.js and read by the admin console.
    match /app_logs/{docId} {
      // Public create is unavoidable: the people who hit these errors are the
      // (unauthenticated) requestors and employees filling in the form, and a log
      // that only records admin sessions would miss every failure worth seeing.
      // The trade-off is that the collection is writable by anyone who reads the
      // public JS — same exposure the rest of this app already has — so the shape
      // and the field sizes are capped here to bound the damage.
      allow create: if request.resource.data.keys().hasOnly([
                         'ts', 'level', 'service', 'action',
                         'ok', 'code', 'message', 'jdId', 'page'
                       ])
                    && request.resource.data.level in ['info', 'warn', 'error']
                    // NOTE: "service" is a reserved word in this language, so the
                    // field has to be reached with [] rather than a dot.
                    && request.resource.data['service'] is string
                    && request.resource.data['service'].size() <= 30
                    && request.resource.data.action is string
                    && request.resource.data.action.size() <= 80
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 600
                    && request.resource.data.ts == request.time;

      // Logs are append-only: not even an admin edits history.
      allow get, list, delete: if isAdmin();
      allow update: if false;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
